# 🔐 ARQUIVO DE CONFIGURAÇÃO - EVOLUTION GO + AGENDAMENTO ELIS

# Copie este arquivo como .env.local (ou .env) na raiz do seu projeto
# Nunca committe este arquivo no Git!
# Adicione .env* no seu .gitignore

# ═══════════════════════════════════════════════════════════════════
# EVOLUTION GO - WhatsApp
# ═══════════════════════════════════════════════════════════════════

# Token de autenticação do Evolution GO
# Obtém no Dashboard: Dashboard → Instance → Token
EVOLUTION_GO_TOKEN=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpbnN0YW5jZSI6ImVsaXMtbWlyYW5kYSIsImlhdCI6MTYyMzQ1Nzc4OH0.xxx

# Nome da instance (criada no Dashboard)
EVOLUTION_GO_INSTANCE=elis-miranda

# Número WhatsApp da Elis (formato internacional, sem caracteres especiais)
# Formato: 5551999999999 (55 Brasil + 51 Porto Alegre + número)
EVOLUTION_GO_PHONE=5551999999999

# URL base da API Evolution GO (geralmente é esta)
EVOLUTION_GO_API_URL=https://api.evolution-api.com

# ═══════════════════════════════════════════════════════════════════
# N8N - Webhooks
# ═══════════════════════════════════════════════════════════════════

# URL do seu webhook n8n para receber agendamentos
# Formato: https://seu-n8n.com/webhook/NOME_DO_WEBHOOK
N8N_WEBHOOK_URL=https://seu-n8n.com/webhook/agendamento-elis

# Se n8n usa autenticação:
N8N_WEBHOOK_TOKEN=seu_token_aqui_se_tiver

# ═══════════════════════════════════════════════════════════════════
# BANCO DE DADOS (Opcional - se quiser salvar agendamentos)
# ═══════════════════════════════════════════════════════════════════

# MongoDB
# DATABASE_URL=mongodb+srv://usuario:senha@cluster.mongodb.net/agendamentos?retryWrites=true

# PostgreSQL
# DATABASE_URL=postgresql://usuario:senha@localhost:5432/elis_agendamentos

# ═══════════════════════════════════════════════════════════════════
# SITE DA ELIS
# ═══════════════════════════════════════════════════════════════════

# URL base do site
SITE_URL=https://elismiranda.com.br

# Email para contato (se quiser enviar cópia dos agendamentos)
ADMIN_EMAIL=elis@elismiranda.com.br

# ═══════════════════════════════════════════════════════════════════
# SEGURANÇA
# ═══════════════════════════════════════════════════════════════════

# Chave secreta para JWT (se usar autenticação)
JWT_SECRET=sua_chave_super_secreta_aqui_com_caracteres_aleatorios

# Ambiente
NODE_ENV=production

# ═══════════════════════════════════════════════════════════════════
# LOGGING & DEBUG
# ═══════════════════════════════════════════════════════════════════

# Debug mode (true/false)
DEBUG=false

# Log level (error, warn, info, debug)
LOG_LEVEL=info

# ═══════════════════════════════════════════════════════════════════
# NOTIFICAÇÕES ADICIONAIS (Futuro)
# ═══════════════════════════════════════════════════════════════════

# Email (sendgrid, gmail, etc)
# SENDGRID_API_KEY=seu_key
# EMAIL_FROM=agendamento@elismiranda.com.br

# Slack (opcional - para notificar Elis de novo agendamento)
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...

# ═══════════════════════════════════════════════════════════════════
# EXEMPLO DE VALORES PREENCHIDOS (APENAS PARA REFERÊNCIA)
# ═══════════════════════════════════════════════════════════════════

# Descomente e adapte para teste:
# EVOLUTION_GO_TOKEN=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpbnN0YW5jZSI6ImVsaXMtbWlyYW5kYSJ9.xxxxx
# EVOLUTION_GO_INSTANCE=elis-miranda
# EVOLUTION_GO_PHONE=5551999999999
# N8N_WEBHOOK_URL=https://n8n.seu-servidor.com/webhook/agendamento-elis

# ═══════════════════════════════════════════════════════════════════
# COMO OBTER OS VALORES
# ═══════════════════════════════════════════════════════════════════

# EVOLUTION_GO_TOKEN:
#   1. Acesse https://dashboard.evolution-api.com
#   2. Clique na instance "elis-miranda"
#   3. Procure por "Token" ou "API Key"
#   4. Copie o valor completo

# EVOLUTION_GO_PHONE:
#   1. Após escanear QR Code no WhatsApp
#   2. Dashboard mostra o número conectado
#   3. Formato: 5551999999999 (sem +, sem espaços)
#   4. Verify: 55 (Brasil) + 51 (Porto Alegre) + seu_numero

# N8N_WEBHOOK_URL:
#   1. Acesse seu n8n
#   2. Crie um workflow
#   3. Adicione nó "Webhook"
#   4. Ative e copie a URL gerada
#   5. Formata: https://seu-n8n.com/webhook/agendamento-elis

# ═══════════════════════════════════════════════════════════════════
# SEGURANÇA: IMPORTANTE!
# ═══════════════════════════════════════════════════════════════════

# ⚠️ NUNCA COMMITTE ESTE ARQUIVO NO GIT!
# 
# Adicione ao .gitignore:
# .env
# .env.local
# .env.*.local
# 
# Se acidentalmente fez commit:
# git rm --cached .env
# git commit -m "Remove .env from tracking"

# Para produção:
# 1. Configure variáveis no host/servidor (Vercel, Heroku, etc)
# 2. Use GitHub Secrets se usar CI/CD
# 3. Nunca coloque valores reais em arquivos versionados
